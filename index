        <input type="range" id="c1-speed" min="0.3" max="3" step="0.1" value="1" />
        <span id="c1-speedVal">1.0×</span>
      </div>
    </div>
  </div>

  <div class="progress"><i id="c1-bar1"></i></div>
</div>
