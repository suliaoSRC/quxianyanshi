    <svg id="c1-chart" viewBox="0 0 1280 520" preserveAspectRatio="none">
      <defs>
        <linearGradient id="c1-areaGrad1" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"  stop-color="#ff4d6d" stop-opacity="0.22"/>
