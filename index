<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>运动衣物细菌与汗味程度的动态变化（案例一 · 案例二）</title>
<style>

  :root {
    --ink:        #1a2540;
    --ink-soft:   #5b6a8a;
    --grid:       rgba(26, 37, 64, 0.08);
    --axis:       rgba(26, 37, 64, 0.40);
    --label:      rgba(26, 37, 64, 0.85);
    --pill-bg:    rgba(255, 255, 255, 0.96);
    --bacteria:   #ff4d6d;
    --smell:      #3b82f6;
    --tip-green:  #16a34a;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body {
    margin: 0; padding: 0;
    background: linear-gradient(135deg, #f0f7ff, #e2effa 50%, #d0e4f7);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }
  .wrap {
    max-width: 100%;
    margin: 0 auto;
    padding: clamp(10px, 2.2vw, 22px) clamp(12px, 2.6vw, 26px);
  }
  .top {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: clamp(12px, 2vw, 22px);
    margin-bottom: clamp(6px, 1vw, 10px);
    flex-wrap: wrap;
  }
  .title-block { flex: 1 1 min(620px, 100%); min-width: 280px; }
  h1 {
    margin: 0 0 6px;
    font-size: clamp(18px, 2.4vw, 26px);
    font-weight: 800;
    color: var(--ink);
    line-height: 1.25;
  }
  .subtitle-1 {
    margin: 0 0 4px;
    font-size: clamp(11px, 1.4vw, 14px);
    line-height: 1.6;
    max-width: 960px;
    font-weight: 600;
    color: #3b82f6;
  }
  .stats {
    display: flex;
    gap: clamp(12px, 2vw, 26px);
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .stat { display: flex; flex-direction: column; align-items: flex-start; min-width: clamp(90px, 12vw, 130px); }
  .stat-num {
    display: flex; align-items: baseline; gap: 5px;
    font-variant-numeric: tabular-nums; line-height: 1.1;
  }
  .stat-num .big {
    font-size: clamp(16px, 2vw, 22px);
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.5px;
  }
  .stat-num .big.c1 { color: var(--bacteria); }
  .stat-num .big.c2 { color: var(--smell); }
  .stat-num small { font-size: clamp(9px, 1vw, 11px); color: var(--ink-soft); font-weight: 600; }
  .stat-label {
    margin-top: 3px;
    font-size: clamp(10px, 1.1vw, 12px);
    color: var(--ink-soft);
    letter-spacing: 0.5px;
  }
  .stage {
    position: relative;
    width: 100%;
    height: clamp(340px, 48vw, 560px);
    background: rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(26, 37, 64, 0.10);
    border-radius: 14px;
    overflow: hidden;
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
  }
  svg { width: 100%; height: 100%; display: block; }
  .chart-legend {
    position: absolute;
    top: clamp(10px, 2vw, 18px);
    left: clamp(20px, 5vw, 70px);
    display: flex; flex-direction: column; gap: 4px;
    pointer-events: none;
    font-size: clamp(10px, 1.2vw, 13px);
    color: var(--ink);
    font-weight: 700;
  }
  .chart-legend .item {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,0.85);
    padding: 3px 10px;
    border-radius: 99px;
    border: 1px solid rgba(26,37,64,0.10);
  }
  .chart-legend .line { width: clamp(14px, 1.6vw, 20px); height: 2px; }
  .chart-legend .line.dashed {
    background-image: linear-gradient(to right, currentColor 60%, transparent 40%);
    background-size: 8px 2px;
    background-repeat: repeat-x;
    height: 2px;
  }
  .bottom {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: clamp(6px, 1vw, 10px);
    gap: 10px;
    flex-wrap: wrap;
  }
  .controls {
    display: flex; align-items: center;
    gap: clamp(6px, 1vw, 12px);
    flex-wrap: wrap;
  }
  .speed {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: clamp(10px, 1.2vw, 13px);
    color: var(--ink-soft);
    background: rgba(255,255,255,0.75);
    padding: clamp(4px, 0.6vw, 6px) clamp(8px, 1vw, 12px);
    border-radius: 99px;
    border: 1px solid rgba(26, 37, 64, 0.10);
  }
  .speed input { accent-color: #6f5cff; width: clamp(70px, 9vw, 120px); }
  button {
    appearance: none;
    border: 1px solid rgba(26, 37, 64, 0.20);
    background: rgba(255, 255, 255, 0.85);
    color: var(--ink);
    padding: clamp(6px, 0.9vw, 9px) clamp(12px, 1.5vw, 18px);
    border-radius: 99px;
    cursor: pointer;
    font-size: clamp(10px, 1.2vw, 13px);
    font-weight: 600;
    transition: all 0.2s;
    backdrop-filter: blur(6px);
    min-height: 36px;
  }
  button:hover { background: rgba(255, 255, 255, 1); }
  button.case1-btn {
    background: linear-gradient(135deg, #ff4d6d, #c72d4d);
    border: none;
    color: #fff;
    box-shadow: 0 4px 14px rgba(255, 77, 109, 0.35);
  }
  button.case1-btn:hover { transform: translateY(-1px); }
  button.reset-btn {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(26, 37, 64, 0.20);
  }
  .progress {
    width: 100%; height: 4px;
    background: rgba(26, 37, 64, 0.08);
    border-radius: 99px; overflow: hidden;
    margin-top: 8px;
  }
  .progress > i {
    display: block; height: 100%;
    background: linear-gradient(90deg, #ff4d6d, #ff7ab8);
    width: 0%;
    transition: width 0.1s linear;
  }

  /* 平板竖屏 / 横屏进一步优化 */
  @media (max-width: 1180px) {
    .wrap { padding: 12px 14px; }
  }
  @media (orientation: landscape) and (max-height: 820px) {
    .stage { height: clamp(300px, 55vh, 460px); }
  }
  @media (orientation: portrait) and (min-width: 900px) {
    .stage { height: clamp(420px, 52vh, 620px); }
  }


  /* ===== 案例切换标签 ===== */
  .page-head {
    display: flex; justify-content: center;
    padding: clamp(12px, 2vw, 20px) 16px 2px;
  }
  .seg {
    display: inline-flex; gap: 4px; padding: 4px;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(26, 37, 64, 0.12);
    border-radius: 99px;
    backdrop-filter: blur(10px);
    box-shadow: 0 6px 20px rgba(26, 37, 64, 0.08);
  }
  .seg-btn {
    border: none; background: transparent;
    color: var(--ink-soft);
    padding: clamp(7px, 1vw, 10px) clamp(16px, 2.2vw, 26px);
    border-radius: 99px; cursor: pointer;
    font-size: clamp(12px, 1.4vw, 15px); font-weight: 700;
    transition: all 0.25s; min-height: 40px;
    font-family: inherit; white-space: nowrap;
  }
  .seg-btn:hover { color: var(--ink); }
  .seg-btn.active[data-case="1"] {
    background: linear-gradient(135deg, #ff4d6d, #c72d4d); color: #fff;
    box-shadow: 0 4px 14px rgba(255, 77, 109, 0.35);
  }
  .seg-btn.active[data-case="2"] {
    background: linear-gradient(135deg, #4f8cff, #2b6ae0); color: #fff;
    box-shadow: 0 4px 14px rgba(79, 140, 255, 0.35);
  }
  .case-panel { display: none; }
  .case-panel.active { display: block; }

  /* 案例二专属：播放按钮与进度条配色 */
  button.case2-btn {
    background: linear-gradient(135deg, #4f8cff, #2b6ae0);
    border: none;
    color: #fff;
    box-shadow: 0 4px 14px rgba(79, 140, 255, 0.35);
  }
  button.case2-btn:hover { transform: translateY(-1px); }
  #panel-case2 .progress > i {
    background: linear-gradient(90deg, #4f8cff, #a566ff);
  }

</style>
</head>
<body>

<div class="page-head">
  <div class="seg" role="tablist">
    <button class="seg-btn active" data-case="1" role="tab">案例一 · 旧衣日常快洗</button>
    <button class="seg-btn" data-case="2" role="tab">案例二 · 标准洗＋除菌</button>
  </div>
</div>

<section class="case-panel active" id="panel-case1">
<div class="wrap">

  <header class="top">
    <div class="title-block">
      <h1>案例一：运动衣物细菌与汗味程度的动态变化</h1>
      <p class="subtitle-1">使用3-4年，日常快洗：细菌虽然看不见，但你闻到的汗味，本质就是细菌的代谢产物。汗味是细菌的信号灯。去汗味更要除菌。</p>
    </div>
