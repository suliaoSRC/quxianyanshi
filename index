<script>
/* ================= 案例一 ================= */
(function () {

/* ---------- 场景轴 ---------- */
const scenes = [
  { label: "运动前\n换洗后衣服",     short: "运动前" },
  { label: "运动中1h\n暴汗",         short: "运动中1h" },
  { label: "运动结束2h\n衣物湿透",   short: "运动结束2h" },
  { label: "浴室堆放\n1h",           short: "堆放1h" },
  { label: "浴室堆放\n2h",           short: "堆放2h" },
  { label: "浴室堆放\n3h",           short: "堆放3h" },
  { label: "浴室堆放\n10h",          short: "堆放10h" }
];

const case1Bacteria = [
  { idx: 0, v: 1650,   tip: "污渍累积多，\n细菌数起始值高" },
  { idx: 1, v: 48000,  tip: "" },
  { idx: 2, v: 70200,  tip: "" },
  { idx: 3, v: 400000, tip: "细菌爆发增长" },
  { idx: 4, v: 300000, tip: "大量细菌代谢物" },
  { idx: 5, v: 320000, tip: "" },
  { idx: 6, v: 176000, tip: "" }
];

const case1Smell = [
  { idx: 0, score: 0, desc: "无异味",       tip: "" },
  { idx: 1, score: 2, desc: "出现汗味",     tip: "" },
  { idx: 2, score: 2, desc: "",             tip: "" },
  { idx: 3, score: 2, desc: "",             tip: "" },
  { idx: 4, score: 3, desc: "汗味酸臭加重", tip: "" },
  { idx: 5, score: 4, desc: "",             tip: "" },
  { idx: 6, score: 5, desc: "💥汗臭味特别严重", tip: "去汗味更要除菌" }
];

const bacteriaColor = "#ff4d6d";
const smellColor = "#3b82f6";
const tipGreen = "#16a34a";

const W = 1280, H = 520;
const PAD_L = 90, PAD_R = 130;
const PAD_T = 30, PAD_B = 90;
const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

const N = scenes.length;

function xAtIndex(i) {
  if (N === 1) return PAD_L + plotW / 2;
  return PAD_L + (i / (N - 1)) * plotW;
}

const Y_MAX_BAC = 400000;
const Y_MAX_SMELL = 5;

function yAtBac(v) {
  const h = Math.max(0, Math.min(1.05, v / Y_MAX_BAC));
  return PAD_T + plotH - h * plotH;
}
function yAtSmell(s) {
  const h = Math.max(0, Math.min(1.05, s / Y_MAX_SMELL));
  return PAD_T + plotH - h * plotH;
}

function buildSamples(points, valueKey) {
  const samples = [];
  for (let i = 0; i < points.length - 1; i++) {
    const a = points[i], b = points[i+1];
    const span = b.idx - a.idx;
    const steps = Math.max(20, Math.floor(span * 30));
    for (let k = 0; k < steps; k++) {
      const u = k / steps;
      const idx = a.idx + span * u;
      const v = a[valueKey] + (b[valueKey] - a[valueKey]) * (1 - Math.cos(u * Math.PI)) / 2;
      samples.push({ idx, v });
    }
  }
  const last = points[points.length-1];
  samples.push({ idx: last.idx, v: last[valueKey] });
  return samples;
}
const samplesBac = buildSamples(case1Bacteria, 'v');
const samplesSmell = buildSamples(case1Smell, 'score');

const gridLayer    = document.getElementById('c1-gridLayer');
const linePath1    = document.getElementById('c1-linePath1');
const linePath2    = document.getElementById('c1-linePath2');
const areaPath1    = document.getElementById('c1-areaPath1');
const dotsLayer1   = document.getElementById('c1-dotsLayer1');
const dotsLayer2   = document.getElementById('c1-dotsLayer2');
const labelsLayer1 = document.getElementById('c1-labelsLayer1');
const labelsLayer2 = document.getElementById('c1-labelsLayer2');
const cursor1      = document.getElementById('c1-cursor1');
const nowVal1El    = document.getElementById('c1-nowVal1');
const nowVal2El    = document.getElementById('c1-nowVal2');
const nowTimeEl    = document.getElementById('c1-nowTime');
const stage        = document.getElementById('c1-stage');
const bar1         = document.getElementById('c1-bar1');

function formatNum(v) {
  if (v >= 1000000) return (v/1000000).toFixed(1) + 'M';
  if (v >= 1000) return (v/1000).toFixed(v>=10000?0:1) + 'k';
  return Math.round(v).toString();
}

function radiusBac(v) {
  if (v >= 400000) return 30;
  if (v >= 100000) return 28;
  if (v >= 10000)  return 26;
  return 20;
}
function radiusSmell(score) {
  return Math.max(8, Math.min(22, Math.sqrt(score) * 7));
}
const FONT_BAC = 14;
const FONT_SMELL = 13;

function drawGrid() {
  let html = '';
  for (let i = 0; i < N; i++) {
    const x = xAtIndex(i);
    html += `<line x1="${x}" y1="${PAD_T}" x2="${x}" y2="${PAD_T+plotH}" stroke="var(--grid)" stroke-width="1"/>`;
    const lines = scenes[i].label.split('\n');
    lines.forEach((ln, li) => {
      html += `<text x="${x}" y="${PAD_T+plotH+20 + li*15}" text-anchor="middle" font-size="11" font-weight="700" fill="var(--label)">${ln}</text>`;
    });
  }
  for (let i = 0; i <= 5; i++) {
    const v = (Y_MAX_BAC / 5) * i;
    const yy = PAD_T + plotH - (i / 5) * plotH;
    html += `<line x1="${PAD_L}" y1="${yy}" x2="${PAD_L+plotW}" y2="${yy}" stroke="var(--grid)" stroke-width="1"/>`;
    html += `<text x="${PAD_L-10}" y="${yy+4}" text-anchor="end" font-size="11" fill="${bacteriaColor}" font-weight="700">${formatNum(v)}</text>`;
  }
  for (let i = 0; i <= 5; i++) {
    const yy = PAD_T + plotH - (i / 5) * plotH;
    html += `<text x="${PAD_L+plotW+10}" y="${yy+4}" text-anchor="start" font-size="11" fill="${smellColor}" font-weight="700">${i}</text>`;
  }
  html += `<line x1="${PAD_L}" y1="${PAD_T}" x2="${PAD_L}" y2="${PAD_T+plotH}" stroke="${bacteriaColor}" stroke-width="1.6"/>`;
  html += `<line x1="${PAD_L+plotW}" y1="${PAD_T}" x2="${PAD_L+plotW}" y2="${PAD_T+plotH}" stroke="${smellColor}" stroke-width="1.6"/>`;
  html += `<line x1="${PAD_L}" y1="${PAD_T+plotH}" x2="${PAD_L+plotW}" y2="${PAD_T+plotH}" stroke="var(--axis)" stroke-width="1.2"/>`;
  gridLayer.innerHTML = html;
}

function buildDotsAndLabels() {
  dotsLayer1.innerHTML = '';
  dotsLayer2.innerHTML = '';
  labelsLayer1.innerHTML = '';
  labelsLayer2.innerHTML = '';

  case1Bacteria.forEach((e, i) => {
    const g = document.createElementNS('http://www.w3.org/2000/svg','g');
    g.setAttribute('class','dot bac');
    g.setAttribute('data-idx', i);
    g.setAttribute('opacity','0');
    const halo = document.createElementNS('http://www.w3.org/2000/svg','circle');
    halo.setAttribute('r','18');
    halo.setAttribute('fill', bacteriaColor);
    halo.setAttribute('opacity','0.18');
    g.appendChild(halo);
    const r = radiusBac(e.v);
    const c = document.createElementNS('http://www.w3.org/2000/svg','circle');
    c.setAttribute('r', r.toFixed(2));
    c.setAttribute('fill', bacteriaColor);
    c.setAttribute('stroke','#fff');
    c.setAttribute('stroke-width','1.5');
    c.setAttribute('filter','url(#c1-glow)');
    g.appendChild(c);
    const txt = document.createElementNS('http://www.w3.org/2000/svg','text');
    txt.setAttribute('fill','#fff');
    txt.setAttribute('font-size', FONT_BAC + 'px');
    txt.setAttribute('font-weight','800');
    txt.setAttribute('text-anchor','middle');
    txt.setAttribute('dy','5');
    txt.textContent = formatNum(e.v);
    g.appendChild(txt);
    dotsLayer1.appendChild(g);

    if (e.tip && e.tip.trim() !== "") {
      const gl = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      gl.setAttribute('class', 'event-label bac');
      gl.setAttribute('data-idx', i);
      gl.setAttribute('opacity', '0');
      const rect = document.createElementNS('http://www.w3.org/2000/svg','rect');
      rect.setAttribute('rx', '10'); rect.setAttribute('ry', '10');
      rect.setAttribute('fill', 'var(--pill-bg)');
      rect.setAttribute('stroke', bacteriaColor);
      rect.setAttribute('stroke-width', '1.6');
      rect.setAttribute('filter', 'url(#c1-glow)');
      gl.appendChild(rect);
      const tag = document.createElementNS('http://www.w3.org/2000/svg','rect');
      tag.setAttribute('width','4'); tag.setAttribute('rx','2');
      tag.setAttribute('fill', bacteriaColor);
      gl.appendChild(tag);
      const lines = e.tip.split('\n');
      lines.forEach((ln) => {
        const t = document.createElementNS('http://www.w3.org/2000/svg','text');
        t.setAttribute('fill', '#1a2540');
        t.setAttribute('font-size', '11');
        t.setAttribute('font-weight', '700');
        t.textContent = ln;
        gl.appendChild(t);
      });
      gl._lines = lines;
      labelsLayer1.appendChild(gl);
    }
  });

  case1Smell.forEach((e, i) => {
    const g = document.createElementNS('http://www.w3.org/2000/svg','g');
    g.setAttribute('class','dot smell');
    g.setAttribute('data-idx', i);
    g.setAttribute('opacity','0');
    const halo = document.createElementNS('http://www.w3.org/2000/svg','circle');
    halo.setAttribute('r','14');
    halo.setAttribute('fill', smellColor);
    halo.setAttribute('opacity','0.18');
    g.appendChild(halo);
    const r = radiusSmell(e.score);
    const c = document.createElementNS('http://www.w3.org/2000/svg','circle');
    c.setAttribute('r', r.toFixed(2));
    c.setAttribute('fill', smellColor);
    c.setAttribute('stroke','#fff');
    c.setAttribute('stroke-width','1.5');
    if (e.score === 4) {
      c.setAttribute('fill-opacity', '0.55');
      c.setAttribute('stroke-opacity', '0.7');
    }
    c.setAttribute('filter','url(#c1-glow)');
    g.appendChild(c);
    const txt = document.createElementNS('http://www.w3.org/2000/svg','text');
    txt.setAttribute('fill','#fff');
    txt.setAttribute('font-size', FONT_SMELL + 'px');
    txt.setAttribute('font-weight','800');
    txt.setAttribute('text-anchor','middle');
    txt.setAttribute('dy','5');
    txt.textContent = e.score;
    if (e.score === 4) txt.setAttribute('fill-opacity', '0.85');
    g.appendChild(txt);
    dotsLayer2.appendChild(g);

    const hasDesc = e.desc && e.desc.trim() !== "";
    const hasTip = e.tip && e.tip.trim() !== "";
    if (!hasDesc && !hasTip) return;

    const gl = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    gl.setAttribute('class', 'event-label smell');
    gl.setAttribute('data-idx', i);
    gl.setAttribute('opacity', '0');
    const rect = document.createElementNS('http://www.w3.org/2000/svg','rect');
    rect.setAttribute('rx', '10'); rect.setAttribute('ry', '10');
    rect.setAttribute('fill', 'var(--pill-bg)');
    rect.setAttribute('stroke', smellColor);
    rect.setAttribute('stroke-width', '1.6');
    rect.setAttribute('filter', 'url(#c1-glow)');
    gl.appendChild(rect);
    const tag = document.createElementNS('http://www.w3.org/2000/svg','rect');
    tag.setAttribute('width','4'); tag.setAttribute('rx','2');
    tag.setAttribute('fill', smellColor);
    gl.appendChild(tag);

    if (hasDesc) {
      const t1 = document.createElementNS('http://www.w3.org/2000/svg','text');
      t1.setAttribute('fill', tipGreen);
      t1.setAttribute('font-size', '11');
      t1.setAttribute('font-weight', '800');
      t1.textContent = e.desc;
      gl.appendChild(t1);
    }
    if (hasTip) {
      const t2 = document.createElementNS('http://www.w3.org/2000/svg','text');
      t2.setAttribute('fill', '#1a2540');
      t2.setAttribute('font-size', '11');
      t2.setAttribute('font-weight', '700');
      t2.textContent = e.tip;
      gl.appendChild(t2);
    }
    gl._hasDesc = hasDesc;
    gl._hasTip = hasTip;
    labelsLayer2.appendChild(gl);
  });
}
buildDotsAndLabels();

let speed = 1;
const totalSteps = N - 1;
const speedInput = document.getElementById('c1-speed');
const speedVal = document.getElementById('c1-speedVal');
speedInput.addEventListener('input', e => {
  speed = parseFloat(e.target.value);
  speedVal.textContent = speed.toFixed(1) + '×';
});

const FULL_DURATION = 18000;
let idx1 = 0;
let playing1 = false;
let animStart1 = null;
let rafId1 = null;

const playBtn1 = document.getElementById('c1-playBtn1');
const resetBtn = document.getElementById('c1-resetBtn');

playBtn1.addEventListener('click', () => { playing1 ? pauseCase1() : playCase1(); });
resetBtn.addEventListener('click', () => { pauseCase1(); idx1 = 0; draw(); });

function playCase1() {
  if (idx1 >= totalSteps - 0.001) idx1 = 0;
  playing1 = true;
  playBtn1.textContent = '⏸ 暂停 案例一';
  animStart1 = performance.now() - (idx1 / totalSteps) * (FULL_DURATION / speed);
  rafId1 = requestAnimationFrame(tick1);
}
function pauseCase1() {
  playing1 = false;
  playBtn1.textContent = '▶ 播放 案例一';
  if (rafId1) cancelAnimationFrame(rafId1);
}
function tick1(now) {
  if (!playing1) return;
  const elapsed = (now - animStart1) * speed;
  idx1 = (elapsed / FULL_DURATION) * totalSteps;
  if (idx1 >= totalSteps) { idx1 = totalSteps; draw(); pauseCase1(); return; }
  draw();
  rafId1 = requestAnimationFrame(tick1);
}

function updateStats() {
  const visBac = samplesBac.filter(s => s.idx <= idx1 + 0.01);
  const visSmell = samplesSmell.filter(s => s.idx <= idx1 + 0.01);
  const liveBac = visBac.length > 0 ? visBac[visBac.length-1].v : 0;
  const liveSmell = visSmell.length > 0 ? visSmell[visSmell.length-1].v : 0;
  nowVal1El.textContent = Math.round(liveBac).toLocaleString();
  nowVal2El.textContent = liveSmell.toFixed(1);
  const nearestIdx = Math.round(idx1);
  const idxClamped = Math.max(0, Math.min(N - 1, nearestIdx));
  nowTimeEl.textContent = scenes[idxClamped].short;
  bar1.style.width = (idx1 / totalSteps * 100).toFixed(1) + '%';
}

function draw() {
  const visBac = samplesBac.filter(s => s.idx <= idx1 + 0.01);
  const visSmell = samplesSmell.filter(s => s.idx <= idx1 + 0.01);

  if (visBac.length > 1) {
    let d = '';
    visBac.forEach((s, i) => {
      const x = xAtIndex(s.idx);
      const y = yAtBac(s.v);
      d += (i === 0 ? `M${x.toFixed(2)} ${y.toFixed(2)}` : ` L${x.toFixed(2)} ${y.toFixed(2)}`);
    });
    linePath1.setAttribute('d', d);
    const firstX = xAtIndex(visBac[0].idx);
    const lastX  = xAtIndex(visBac[visBac.length-1].idx);
    const baseY  = PAD_T + plotH;
    areaPath1.setAttribute('d', d + ` L${lastX.toFixed(2)} ${baseY} L${firstX.toFixed(2)} ${baseY} Z`);
  } else { linePath1.setAttribute('d', ''); areaPath1.setAttribute('d', ''); }

  if (visSmell.length > 1) {
    let d = '';
    visSmell.forEach((s, i) => {
      const x = xAtIndex(s.idx);
      const y = yAtSmell(s.v);
      d += (i === 0 ? `M${x.toFixed(2)} ${y.toFixed(2)}` : ` L${x.toFixed(2)} ${y.toFixed(2)}`);
    });
    linePath2.setAttribute('d', d);
  } else { linePath2.setAttribute('d', ''); }

  cursor1.setAttribute('x1', xAtIndex(idx1));
  cursor1.setAttribute('x2', xAtIndex(idx1));

  drawGrid();

  const dotNodesBac = dotsLayer1.querySelectorAll('.dot.bac');
  dotNodesBac.forEach((node, i) => {
    const e = case1Bacteria[i];
    if (e.idx <= idx1 + 0.5) {
      node.setAttribute('opacity', '1');
      node.setAttribute('transform', `translate(${xAtIndex(e.idx).toFixed(2)}, ${yAtBac(e.v).toFixed(2)})`);
    } else { node.setAttribute('opacity', '0'); }
  });

  const dotNodesSmell = dotsLayer2.querySelectorAll('.dot.smell');
  dotNodesSmell.forEach((node, i) => {
    const e = case1Smell[i];
    if (e.idx <= idx1 + 0.5) {
      node.setAttribute('opacity', '1');
      node.setAttribute('transform', `translate(${xAtIndex(e.idx).toFixed(2)}, ${yAtSmell(e.score).toFixed(2)})`);
    } else { node.setAttribute('opacity', '0'); }
  });

  const labelNodesBac = labelsLayer1.querySelectorAll('.event-label.bac');
  labelNodesBac.forEach((node) => {
    const i = parseInt(node.getAttribute('data-idx'), 10);
    const e = case1Bacteria[i];
    if (e.idx <= idx1 + 0.5) {
      node.setAttribute('opacity', '1');
      const x = xAtIndex(e.idx);
      const y = yAtBac(e.v);
      const lines = node._lines;
      const texts = node.querySelectorAll('text');
      let maxW = 0;
      texts.forEach(t => { maxW = Math.max(maxW, t.getComputedTextLength?.() ?? 120); });
      const w = maxW + 22;
      const h = lines.length * 15 + 14;
      let tx = x - w / 2;
      let ty = y - h - 30;
      if (e.idx === 0) { tx = x - w / 2; ty = y - h - 80; }
      else if (e.idx === 3) { tx = x - w - 100; ty = yAtBac(300000) - h / 2; }
      else if (e.idx === 4) { tx = x - w / 2 + 80; ty = yAtSmell(5) + 30; }
      tx = Math.max(PAD_L + 4, Math.min(PAD_L + plotW - w - 4, tx));
      ty = Math.max(PAD_T + 4, ty);
      node.setAttribute('transform', `translate(${tx.toFixed(2)}, ${ty.toFixed(2)})`);
      const rect = node.querySelector('rect:first-child');
      rect.setAttribute('width', w);
      rect.setAttribute('height', h);
      node.querySelectorAll('rect')[1].setAttribute('height', h);
      lines.forEach((ln, li) => {
        texts[li].setAttribute('x', 12);
        texts[li].setAttribute('y', 19 + li * 15);
      });
    } else { node.setAttribute('opacity', '0'); }
  });

  const labelNodesSmell = labelsLayer2.querySelectorAll('.event-label.smell');
  labelNodesSmell.forEach((node) => {
    const i = parseInt(node.getAttribute('data-idx'), 10);
    const e = case1Smell[i];
    if (e.idx <= idx1 + 0.5) {
      node.setAttribute('opacity', '1');
      const x = xAtIndex(e.idx);
      const y = yAtSmell(e.score);
      const texts = node.querySelectorAll('text');
      let maxW = 0;
      texts.forEach(t => { maxW = Math.max(maxW, t.getComputedTextLength?.() ?? 120); });
      const w = maxW + 22;
      const h = (node._hasDesc && node._hasTip) ? 48 : 30;
      let tx = x - w / 2;
      let ty = y + 30;
      if (e.idx === 0) { ty = y + 15; }
      if (e.idx === 6) { tx = x + 20; }
      tx = Math.max(PAD_L + 4, Math.min(PAD_L + plotW - w - 4, tx));
      ty = Math.min(PAD_T + plotH - h - 4, ty);
      node.setAttribute('transform', `translate(${tx.toFixed(2)}, ${ty.toFixed(2)})`);
      const rect = node.querySelector('rect:first-child');
      rect.setAttribute('width', w);
      rect.setAttribute('height', h);
      node.querySelectorAll('rect')[1].setAttribute('height', h);
      if (texts[0]) { texts[0].setAttribute('x', 12); texts[0].setAttribute('y', 19); }
      if (texts[1]) { texts[1].setAttribute('x', 12); texts[1].setAttribute('y', 36); }
    } else { node.setAttribute('opacity', '0'); }
  });

  updateStats();
}

draw();

  window.__case1 = { pause: pauseCase1, redraw: draw };
})();
</script>

<script>
/* ================= 案例二 ================= */
(function () {

/* ---------- 场景轴 ---------- */
const scenes = [
  { label: "运动前\n换洗后衣服",     short: "运动前" },
  { label: "运动中1h\n暴汗",         short: "运动中1h" },
  { label: "运动结束2h\n衣物湿透",   short: "运动结束2h" },
  { label: "浴室堆放\n1h",           short: "堆放1h" },
  { label: "浴室堆放\n2h",           short: "堆放2h" },
  { label: "浴室堆放\n3h",           short: "堆放3h" },
  { label: "浴室堆放\n4h",           short: "堆放4h" },
  { label: "浴室堆放\n11h",          short: "堆放11h" }
];

const case2Bacteria = [
  { idx: 0, v: 60,    tip: "" },
  { idx: 1, v: 100,   tip: "" },
  { idx: 2, v: 340,   tip: "⭐日常除菌是关键" },
  { idx: 3, v: 110,   tip: "" },
  { idx: 4, v: 235,   tip: "" },
  { idx: 5, v: 115,   tip: "" },
  { idx: 6, v: 315,   tip: "" },
  { idx: 7, v: 6250,  tip: "细菌滋生\n及时洗涤很重要" }
];

const case2Smell = [
  { idx: 0, score: 0, desc: "无异味",       tip: "" },
  { idx: 1, score: 0, desc: "",             tip: "" },
  { idx: 2, score: 0, desc: "无异味困扰",   tip: "" },
  { idx: 3, score: 0, desc: "",             tip: "" },
  { idx: 4, score: 1, desc: "轻微汗味",     tip: "" },
  { idx: 5, score: 1, desc: "",             tip: "" },
  { idx: 6, score: 2, desc: "",             tip: "" },
  { idx: 7, score: 4, desc: "汗味酸臭",     tip: "" }
];

const bacteriaColor = "#ff4d6d";
const smellColor = "#3b82f6";
const tipGreen = "#16a34a";

const W = 1280, H = 520;
const PAD_L = 90, PAD_R = 130;
const PAD_T = 30, PAD_B = 90;
const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

const N = scenes.length;

function xAtIndex(i) {
  if (N === 1) return PAD_L + plotW / 2;
  return PAD_L + (i / (N - 1)) * plotW;
}

const Y_MAX_BAC = 7000;
const Y_MAX_SMELL = 5;

function yAtBac(v) {
  const h = Math.max(0, Math.min(1.05, v / Y_MAX_BAC));
  return PAD_T + plotH - h * plotH;
}
function yAtSmell(s) {
  const h = Math.max(0, Math.min(1.05, s / Y_MAX_SMELL));
  return PAD_T + plotH - h * plotH;
}

function buildSamples(points, valueKey) {
  const samples = [];
  for (let i = 0; i < points.length - 1; i++) {
    const a = points[i], b = points[i+1];
    const span = b.idx - a.idx;
    const steps = Math.max(20, Math.floor(span * 30));
    for (let k = 0; k < steps; k++) {
      const u = k / steps;
      const idx = a.idx + span * u;
      const v = a[valueKey] + (b[valueKey] - a[valueKey]) * (1 - Math.cos(u * Math.PI)) / 2;
      samples.push({ idx, v });
    }
  }
  const last = points[points.length-1];
  samples.push({ idx: last.idx, v: last[valueKey] });
  return samples;
}
const samplesBac = buildSamples(case2Bacteria, 'v');
const samplesSmell = buildSamples(case2Smell, 'score');

const gridLayer    = document.getElementById('c2-gridLayer');
const linePath1    = document.getElementById('c2-linePath1');
const linePath2    = document.getElementById('c2-linePath2');
const areaPath1    = document.getElementById('c2-areaPath1');
const dotsLayer1   = document.getElementById('c2-dotsLayer1');
const dotsLayer2   = document.getElementById('c2-dotsLayer2');
const labelsLayer1 = document.getElementById('c2-labelsLayer1');
const labelsLayer2 = document.getElementById('c2-labelsLayer2');
const cursor1      = document.getElementById('c2-cursor1');
const nowVal1El    = document.getElementById('c2-nowVal1');
const nowVal2El    = document.getElementById('c2-nowVal2');
const nowTimeEl    = document.getElementById('c2-nowTime');
const stage        = document.getElementById('c2-stage');
const bar1         = document.getElementById('c2-bar1');

function formatNum(v) {
  if (v >= 1000000) return (v/1000000).toFixed(1) + 'M';
  if (v >= 1000) return (v/1000).toFixed(v>=10000?0:1) + 'k';
  return Math.round(v).toString();
}

function radiusBac(v, idx) {
  if (idx === 7) return 22;
  if (idx >= 1 && idx <= 6) return 17;
  return Math.max(10, Math.min(36, Math.sqrt(v) * 0.75));
}
function radiusSmell(score) {
  return Math.max(8, Math.min(20, Math.sqrt(score) * 8));
}
const FONT_BAC = 13;
const FONT_SMELL = 13;

function drawGrid() {
  let html = '';
  for (let i = 0; i < N; i++) {
    const x = xAtIndex(i);
    html += `<line x1="${x}" y1="${PAD_T}" x2="${x}" y2="${PAD_T+plotH}" stroke="var(--grid)" stroke-width="1"/>`;
    const lines = scenes[i].label.split('\n');
    lines.forEach((ln, li) => {
      html += `<text x="${x}" y="${PAD_T+plotH+20 + li*15}" text-anchor="middle" font-size="11" font-weight="700" fill="var(--label)">${ln}</text>`;
    });
  }
  for (let i = 0; i <= 5; i++) {
    const v = (Y_MAX_BAC / 5) * i;
    const yy = PAD_T + plotH - (i / 5) * plotH;
    html += `<line x1="${PAD_L}" y1="${yy}" x2="${PAD_L+plotW}" y2="${yy}" stroke="var(--grid)" stroke-width="1"/>`;
    html += `<text x="${PAD_L-10}" y="${yy+4}" text-anchor="end" font-size="11" fill="${bacteriaColor}" font-weight="700">${formatNum(v)}</text>`;
  }
  for (let i = 0; i <= 5; i++) {
    const yy = PAD_T + plotH - (i / 5) * plotH;
    html += `<text x="${PAD_L+plotW+10}" y="${yy+4}" text-anchor="start" font-size="11" fill="${smellColor}" font-weight="700">${i}</text>`;
  }
  html += `<line x1="${PAD_L}" y1="${PAD_T}" x2="${PAD_L}" y2="${PAD_T+plotH}" stroke="${bacteriaColor}" stroke-width="1.6"/>`;
  html += `<line x1="${PAD_L+plotW}" y1="${PAD_T}" x2="${PAD_L+plotW}" y2="${PAD_T+plotH}" stroke="${smellColor}" stroke-width="1.6"/>`;
  html += `<line x1="${PAD_L}" y1="${PAD_T+plotH}" x2="${PAD_L+plotW}" y2="${PAD_T+plotH}" stroke="var(--axis)" stroke-width="1.2"/>`;
  gridLayer.innerHTML = html;
}

function buildDotsAndLabels() {
  dotsLayer1.innerHTML = '';
  dotsLayer2.innerHTML = '';
  labelsLayer1.innerHTML = '';
  labelsLayer2.innerHTML = '';

  case2Bacteria.forEach((e, i) => {
    const g = document.createElementNS('http://www.w3.org/2000/svg','g');
    g.setAttribute('class','dot bac');
    g.setAttribute('data-idx', i);
    g.setAttribute('opacity','0');
    const halo = document.createElementNS('http://www.w3.org/2000/svg','circle');
    halo.setAttribute('r','18');
    halo.setAttribute('fill', bacteriaColor);
    halo.setAttribute('opacity','0.18');
    g.appendChild(halo);
    const r = radiusBac(e.v, e.idx);
    const c = document.createElementNS('http://www.w3.org/2000/svg','circle');
    c.setAttribute('r', r.toFixed(2));
    c.setAttribute('fill', bacteriaColor);
    c.setAttribute('stroke','#fff');
    c.setAttribute('stroke-width','1.5');
    c.setAttribute('filter','url(#c2-glow)');
    g.appendChild(c);
    const txt = document.createElementNS('http://www.w3.org/2000/svg','text');
    txt.setAttribute('fill','#fff');
    txt.setAttribute('font-size', FONT_BAC + 'px');
    txt.setAttribute('font-weight','800');
    txt.setAttribute('text-anchor','middle');
    txt.setAttribute('dy','5');
    txt.textContent = formatNum(e.v);
    g.appendChild(txt);
    dotsLayer1.appendChild(g);

    if (e.tip && e.tip.trim() !== "") {
      const gl = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      gl.setAttribute('class', 'event-label bac');
      gl.setAttribute('data-idx', i);
      gl.setAttribute('opacity', '0');
      const rect = document.createElementNS('http://www.w3.org/2000/svg','rect');
      rect.setAttribute('rx', '10'); rect.setAttribute('ry', '10');
      rect.setAttribute('fill', 'var(--pill-bg)');
      rect.setAttribute('stroke', bacteriaColor);
      rect.setAttribute('stroke-width', '1.6');
      rect.setAttribute('filter', 'url(#c2-glow)');
      gl.appendChild(rect);
      const tag = document.createElementNS('http://www.w3.org/2000/svg','rect');
      tag.setAttribute('width','4'); tag.setAttribute('rx','2');
      tag.setAttribute('fill', bacteriaColor);
      gl.appendChild(tag);
      const lines = e.tip.split('\n');
      lines.forEach((ln) => {
        const t = document.createElementNS('http://www.w3.org/2000/svg','text');
        t.setAttribute('fill', '#1a2540');
        t.setAttribute('font-size', '11');
        t.setAttribute('font-weight', '700');
        t.textContent = ln;
        gl.appendChild(t);
      });
      gl._lines = lines;
      labelsLayer1.appendChild(gl);
    }
  });

  case2Smell.forEach((e, i) => {
    const g = document.createElementNS('http://www.w3.org/2000/svg','g');
    g.setAttribute('class','dot smell');
    g.setAttribute('data-idx', i);
    g.setAttribute('opacity','0');
    const halo = document.createElementNS('http://www.w3.org/2000/svg','circle');
    halo.setAttribute('r','12');
    halo.setAttribute('fill', smellColor);
    halo.setAttribute('opacity','0.18');
    g.appendChild(halo);
    const r = radiusSmell(e.score);
    const c = document.createElementNS('http://www.w3.org/2000/svg','circle');
    c.setAttribute('r', r.toFixed(2));
    c.setAttribute('fill', smellColor);
    c.setAttribute('stroke','#fff');
    c.setAttribute('stroke-width','1.5');
    c.setAttribute('filter','url(#c2-glow)');
    g.appendChild(c);
    const txt = document.createElementNS('http://www.w3.org/2000/svg','text');
    txt.setAttribute('fill','#fff');
    txt.setAttribute('font-size', FONT_SMELL + 'px');
    txt.setAttribute('font-weight','800');
    txt.setAttribute('text-anchor','middle');
    txt.setAttribute('dy','5');
    txt.textContent = e.score;
    g.appendChild(txt);
    dotsLayer2.appendChild(g);

    const hasDesc = e.desc && e.desc.trim() !== "";
    const hasTip = e.tip && e.tip.trim() !== "";
    if (!hasDesc && !hasTip) return;

    const gl = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    gl.setAttribute('class', 'event-label smell');
    gl.setAttribute('data-idx', i);
    gl.setAttribute('opacity', '0');
    const rect = document.createElementNS('http://www.w3.org/2000/svg','rect');
    rect.setAttribute('rx', '10'); rect.setAttribute('ry', '10');
    rect.setAttribute('fill', 'var(--pill-bg)');
    rect.setAttribute('stroke', smellColor);
    rect.setAttribute('stroke-width', '1.6');
    rect.setAttribute('filter', 'url(#c2-glow)');
    gl.appendChild(rect);
    const tag = document.createElementNS('http://www.w3.org/2000/svg','rect');
    tag.setAttribute('width','4'); tag.setAttribute('rx','2');
    tag.setAttribute('fill', smellColor);
    gl.appendChild(tag);

    if (hasDesc) {
      const t1 = document.createElementNS('http://www.w3.org/2000/svg','text');
      t1.setAttribute('fill', tipGreen);
      t1.setAttribute('font-size', '11');
      t1.setAttribute('font-weight', '800');
      t1.textContent = e.desc;
      gl.appendChild(t1);
    }
    if (hasTip) {
      const t2 = document.createElementNS('http://www.w3.org/2000/svg','text');
      t2.setAttribute('fill', '#1a2540');
      t2.setAttribute('font-size', '11');
      t2.setAttribute('font-weight', '700');
      t2.textContent = e.tip;
      gl.appendChild(t2);
    }
    gl._hasDesc = hasDesc;
    gl._hasTip = hasTip;
    labelsLayer2.appendChild(gl);
  });
}
buildDotsAndLabels();

let speed = 1;
const totalSteps = N - 1;
const speedInput = document.getElementById('c2-speed');
const speedVal = document.getElementById('c2-speedVal');
speedInput.addEventListener('input', e => {
  speed = parseFloat(e.target.value);
  speedVal.textContent = speed.toFixed(1) + '×';
});

const FULL_DURATION = 18000;
let idx1 = 0;
let playing1 = false;
let animStart1 = null;
let rafId1 = null;

const playBtn1 = document.getElementById('c2-playBtn1');
const resetBtn = document.getElementById('c2-resetBtn');

playBtn1.addEventListener('click', () => { playing1 ? pauseCase1() : playCase1(); });
resetBtn.addEventListener('click', () => { pauseCase1(); idx1 = 0; draw(); });

function playCase1() {
  if (idx1 >= totalSteps - 0.001) idx1 = 0;
  playing1 = true;
  playBtn1.textContent = '⏸ 暂停 案例二';
  animStart1 = performance.now() - (idx1 / totalSteps) * (FULL_DURATION / speed);
  rafId1 = requestAnimationFrame(tick1);
}
function pauseCase1() {
  playing1 = false;
  playBtn1.textContent = '▶ 播放 案例二';
  if (rafId1) cancelAnimationFrame(rafId1);
}
function tick1(now) {
  if (!playing1) return;
  const elapsed = (now - animStart1) * speed;
  idx1 = (elapsed / FULL_DURATION) * totalSteps;
  if (idx1 >= totalSteps) { idx1 = totalSteps; draw(); pauseCase1(); return; }
  draw();
  rafId1 = requestAnimationFrame(tick1);
}

function updateStats() {
  const visBac = samplesBac.filter(s => s.idx <= idx1 + 0.01);
  const visSmell = samplesSmell.filter(s => s.idx <= idx1 + 0.01);
  const liveBac = visBac.length > 0 ? visBac[visBac.length-1].v : 0;
  const liveSmell = visSmell.length > 0 ? visSmell[visSmell.length-1].v : 0;
  nowVal1El.textContent = Math.round(liveBac).toLocaleString();
  nowVal2El.textContent = liveSmell.toFixed(1);
  const nearestIdx = Math.round(idx1);
  const idxClamped = Math.max(0, Math.min(N - 1, nearestIdx));
  nowTimeEl.textContent = scenes[idxClamped].short;
  bar1.style.width = (idx1 / totalSteps * 100).toFixed(1) + '%';
}

function draw() {
  const visBac = samplesBac.filter(s => s.idx <= idx1 + 0.01);
  const visSmell = samplesSmell.filter(s => s.idx <= idx1 + 0.01);

  if (visBac.length > 1) {
    let d = '';
    visBac.forEach((s, i) => {
      const x = xAtIndex(s.idx);
      const y = yAtBac(s.v);
      d += (i === 0 ? `M${x.toFixed(2)} ${y.toFixed(2)}` : ` L${x.toFixed(2)} ${y.toFixed(2)}`);
    });
    linePath1.setAttribute('d', d);
    const firstX = xAtIndex(visBac[0].idx);
    const lastX  = xAtIndex(visBac[visBac.length-1].idx);
    const baseY  = PAD_T + plotH;
    areaPath1.setAttribute('d', d + ` L${lastX.toFixed(2)} ${baseY} L${firstX.toFixed(2)} ${baseY} Z`);
  } else { linePath1.setAttribute('d', ''); areaPath1.setAttribute('d', ''); }

  if (visSmell.length > 1) {
    let d = '';
    visSmell.forEach((s, i) => {
      const x = xAtIndex(s.idx);
      const y = yAtSmell(s.v);
      d += (i === 0 ? `M${x.toFixed(2)} ${y.toFixed(2)}` : ` L${x.toFixed(2)} ${y.toFixed(2)}`);
    });
    linePath2.setAttribute('d', d);
  } else { linePath2.setAttribute('d', ''); }

  cursor1.setAttribute('x1', xAtIndex(idx1));
  cursor1.setAttribute('x2', xAtIndex(idx1));

  drawGrid();

  const dotNodesBac = dotsLayer1.querySelectorAll('.dot.bac');
  dotNodesBac.forEach((node, i) => {
    const e = case2Bacteria[i];
    if (e.idx <= idx1 + 0.5) {
      node.setAttribute('opacity', '1');
      node.setAttribute('transform', `translate(${xAtIndex(e.idx).toFixed(2)}, ${yAtBac(e.v).toFixed(2)})`);
    } else { node.setAttribute('opacity', '0'); }
  });

  const dotNodesSmell = dotsLayer2.querySelectorAll('.dot.smell');
  dotNodesSmell.forEach((node, i) => {
    const e = case2Smell[i];
    if (e.idx <= idx1 + 0.5) {
      node.setAttribute('opacity', '1');
      node.setAttribute('transform', `translate(${xAtIndex(e.idx).toFixed(2)}, ${yAtSmell(e.score).toFixed(2)})`);
    } else { node.setAttribute('opacity', '0'); }
  });

  const labelNodesBac = labelsLayer1.querySelectorAll('.event-label.bac');
  labelNodesBac.forEach((node) => {
    const i = parseInt(node.getAttribute('data-idx'), 10);
    const e = case2Bacteria[i];
    if (e.idx <= idx1 + 0.5) {
      node.setAttribute('opacity', '1');
      const x = xAtIndex(e.idx);
      const y = yAtBac(e.v);
      const lines = node._lines;
      const texts = node.querySelectorAll('text');
      let maxW = 0;
      texts.forEach(t => { maxW = Math.max(maxW, t.getComputedTextLength?.() ?? 120); });
      const w = maxW + 22;
      const h = lines.length * 15 + 14;
      let tx = x - w / 2;
      let ty = y - h - 30;
      if (e.idx === 2) { tx = x - w / 2; ty = y - h - 25; }
      if (e.idx === 7) {
        const xMid = (xAtIndex(6) + xAtIndex(7)) / 2;
        tx = xMid - w / 2;
        ty = y - h - 30;
      }
      tx = Math.max(PAD_L + 4, Math.min(PAD_L + plotW - w - 4, tx));
      ty = Math.max(PAD_T + 4, ty);
      node.setAttribute('transform', `translate(${tx.toFixed(2)}, ${ty.toFixed(2)})`);
      const rect = node.querySelector('rect:first-child');
      rect.setAttribute('width', w);
      rect.setAttribute('height', h);
      node.querySelectorAll('rect')[1].setAttribute('height', h);
      lines.forEach((ln, li) => {
        texts[li].setAttribute('x', 12);
        texts[li].setAttribute('y', 19 + li * 15);
      });
    } else { node.setAttribute('opacity', '0'); }
  });

  const labelNodesSmell = labelsLayer2.querySelectorAll('.event-label.smell');
  labelNodesSmell.forEach((node) => {
    const i = parseInt(node.getAttribute('data-idx'), 10);
    const e = case2Smell[i];
    if (e.idx <= idx1 + 0.5) {
      node.setAttribute('opacity', '1');
      const x = xAtIndex(e.idx);
      const y = yAtSmell(e.score);
      const texts = node.querySelectorAll('text');
      let maxW = 0;
      texts.forEach(t => { maxW = Math.max(maxW, t.getComputedTextLength?.() ?? 120); });
      const w = maxW + 22;
      const h = (node._hasDesc && node._hasTip) ? 48 : 30;
      let tx = x - w / 2;
      let ty = y + 30;
      if (e.idx === 0) { tx = x - w / 2; ty = yAtBac(340) - h - 40; }
      if (e.idx === 2) { tx = x - w / 2; ty = yAtBac(340) - 25 - 34 - h - 12; }
      if (e.idx === 4) { tx = x - w / 2; ty = y - h - 25; }
      if (e.idx === 7) { tx = x - w - 140; ty = yAtSmell(2) - h - 20; }
      tx = Math.max(PAD_L + 4, Math.min(PAD_L + plotW - w - 4, tx));
      ty = Math.min(PAD_T + plotH - h - 4, ty);
      node.setAttribute('transform', `translate(${tx.toFixed(2)}, ${ty.toFixed(2)})`);
      const rect = node.querySelector('rect:first-child');
      rect.setAttribute('width', w);
      rect.setAttribute('height', h);
      node.querySelectorAll('rect')[1].setAttribute('height', h);
      if (texts[0]) { texts[0].setAttribute('x', 12); texts[0].setAttribute('y', 19); }
      if (texts[1]) { texts[1].setAttribute('x', 12); texts[1].setAttribute('y', 36); }
    } else { node.setAttribute('opacity', '0'); }
  });

  updateStats();
}

draw();

  window.__case2 = { pause: pauseCase1, redraw: draw };
})();
</script>

<script>
/* ================= 切换逻辑 ================= */
(function () {
  const btns = document.querySelectorAll('.seg-btn');
  const panels = {
    '1': document.getElementById('panel-case1'),
    '2': document.getElementById('panel-case2')
  };
  btns.forEach(btn => btn.addEventListener('click', () => {
    if (btn.classList.contains('active')) return;
    btns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const target = btn.dataset.case;
    panels['1'].classList.toggle('active', target === '1');
    panels['2'].classList.toggle('active', target === '2');
    if (target === '1') {
      window.__case2 && window.__case2.pause();
      requestAnimationFrame(() => window.__case1 && window.__case1.redraw());
    } else {
      window.__case1 && window.__case1.pause();
      requestAnimationFrame(() => window.__case2 && window.__case2.redraw());
    }
    window.scrollTo(0, 0);
  }));
})();
</script>

