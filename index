      <g id="c1-dotsLayer2"></g>
      <path id="c1-linePath1" fill="none" stroke="#ff4d6d" stroke-width="2.8"
            stroke-linecap="round" stroke-linejoin="round" filter="url(#c1-glow)" d=""/>
      <g id="c1-dotsLayer1"></g>
      <g id="c1-labelsLayer1"></g>
      <g id="c1-labelsLayer2"></g>
      <line id="c1-cursor1" x1="0" y1="40" x2="0" y2="440" stroke="#ff4d6d"
            stroke-width="1.2" stroke-dasharray="4 4" opacity="0.65"/>
      <text id="c1-ymaxLabelLeft" x="20" y="16" text-anchor="start"
            font-size="12" fill="#ff4d6d" font-weight="700">菌含量 (CFU/25c㎡)</text>
      <text id="c1-ymaxLabelRight" x="1260" y="16" text-anchor="end"
            font-size="12" fill="#3b82f6" font-weight="700">异味评分 (0-5分)</text>
    </svg>
  </div>

  <div class="bottom">
    <div class="controls">
      <button id="c1-resetBtn" class="reset-btn">⟲ 重播</button>
